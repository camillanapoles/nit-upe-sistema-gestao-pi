# Worktree Environment Isolation
# These files MUST be ignored to prevent cross-worktree contamination
.claude.worktree/
.gitignore.local

# OpenSpec lock file (auto-generated, not committed)
.openspec-lock

# Worktree-specific environment overrides
.env.local
.env.*.local

# Local Claude session data (per worktree)
.claude/

# Editor and IDE - worktree specific
.vscode/settings.local.json
.idea/

# OS artifacts
.DS_Store
Thumbs.db
*~

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*.bak

# Logs (worktree specific)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
*.pid
*.seed
*.pid.lock

# Cache directories
.cache/
.parcel-cache/
.nyc_output/

# Coverage (worktree specific)
coverage/
.nyc_output/

# Build artifacts (worktree specific)
dist/
build/
.out/

# Node modules (worktree specific)
# node_modules/ - handled by each sub-project

# Lock files - worktree specific
package-lock.json.local
yarn.lock.local
pnpm-lock.yaml.local

# Test artifacts
test-results/
playwright-report/
playwright/.cache/

# Misc
*.pem
