{
  "name": "crush-teacher",
  "version": "1.0.0",
  "description": "Sistema de Gestão de Propriedade Intelectual - Universidade de Pernambuco (UPE) - Projeto Crush",
  "main": "docs/index.html",
  "scripts": {
    "test": "echo \"Running tests...\" && node docs/assets/js/tests.js",
    "validate": "echo \"Running validation...\" && npm run validate-html && npm run validate-css && npm run validate-js",
    "validate-html": "html-validator docs/index.html --verbose",
    "validate-css": "stylelint docs/assets/css/style.css --formatter compact",
    "validate-js": "eslint docs/assets/js/tests.js",
    "lint": "npm run validate",
    "format": "echo \"Formatting code...\"",
    "build": "echo \"Building...\"",
    "serve": "python -m http.server 8000 --directory docs",
    "deploy": "echo \"Deploying...\""
  },
  "keywords": [
    "uap",
    "propriedade-intelectual",
    "patentes",
    "inovação",
    "nit",
    "crush"
  ],
  "author": "Universidade de Pernambuco (UPE) - NIT",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/crush-teacher.git"
  },
  "devDependencies": {
    "eslint": "^10.0.2",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "markdownlint-cli": "^0.38.0",
    "html-validator": "^6.1.2",
    "link-checker": "^0.0.19",
    "pa11y": "^7.0.0",
    "trivy": "^0.51.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "private": true
}
