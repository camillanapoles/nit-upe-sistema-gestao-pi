# Database - PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Exemplo local: postgresql://postgres:postgres@localhost:5432/nit_upe
# Exemplo Docker: postgresql://nit_upe:nit_upe_pass@localhost:5432/nit_upe
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nit_upe"

# JWT - Autenticação
# Use uma string secreta forte (mínimo 32 caracteres)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Application
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"
